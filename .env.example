# Server-only email settings used by api/lead.js. Configure real values in Vercel.
LEAD_RECIPIENT_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=AI Consulting SA <hello@aiconsultingsa.com>

# Local Visibility Audit: server-only. This one price value is the checkout gate.
# Leave blank until the correct AI Consulting SA account and webhook are ready.
AUDIT_STRIPE_PRICE_ID=
STRIPE_SECRET_KEY=
AUDIT_STRIPE_WEBHOOK_SECRET=
AUDIT_ADMIN_TOKEN=
# Optional Stripe-hosted purchase links. Missing/invalid values show closed slots.
AUDIT_FIX_CHECKOUT_URL=
AUDIT_RECEPTIONIST_CHECKOUT_URL=
